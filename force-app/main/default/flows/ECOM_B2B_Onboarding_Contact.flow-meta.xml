<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description>Contact-triggered onboarding journey for ECOM_B2B accounts. Sends Buyer, PayLater, New Account, and Branch Contact Master summary emails.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsEcomB2B</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBLANK({!$Record.AccountId})),
{!Get_Account.RecordType.DeveloperName} = "ECOM_B2B"
)</expression>
    </formulas>
    <formulas>
        <name>IsBuyerAccount</name>
        <dataType>Boolean</dataType>
        <expression>TEXT({!Get_Account.Type}) = "Buyer"</expression>
    </formulas>
    <formulas>
        <name>IsPayLaterAccount</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(LOWER(TEXT({!Get_Account.Type})), "paylater")</expression>
    </formulas>
    <formulas>
        <name>NewAccountRecipients</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!Get_Account_AP.Email}),
IF(ISBLANK({!Get_Parent_Account_AP.Email}), "", {!Get_Parent_Account_AP.Email}),
IF(ISBLANK({!Get_Parent_Account_AP.Email}), {!Get_Account_AP.Email}, {!Get_Account_AP.Email} &amp; "," &amp; {!Get_Parent_Account_AP.Email})
)</expression>
    </formulas>
    <formulas>
        <name>BuyerAccountSubject</name>
        <dataType>String</dataType>
        <expression>"Buyer Account Email - " &amp; {!Get_Account.Name}</expression>
    </formulas>
    <formulas>
        <name>BuyerAccountBody</name>
        <dataType>String</dataType>
        <expression>"Buyer account onboarding started for customer: " &amp; {!Get_Account.Name}
&amp; BR() &amp; "Customer ID: " &amp; IF(ISBLANK({!Get_Account.AccountNumber}), {!Get_Account.Id}, {!Get_Account.AccountNumber})
&amp; BR() &amp; "This is an internal onboarding notification."</expression>
    </formulas>
    <formulas>
        <name>PayLaterSubject</name>
        <dataType>String</dataType>
        <expression>"PayLater Account Email - " &amp; {!Get_Account.Name}</expression>
    </formulas>
    <formulas>
        <name>PayLaterBody</name>
        <dataType>String</dataType>
        <expression>"PayLater account onboarding alert for customer: " &amp; {!Get_Account.Name}
&amp; BR() &amp; "Customer ID: " &amp; IF(ISBLANK({!Get_Account.AccountNumber}), {!Get_Account.Id}, {!Get_Account.AccountNumber})
&amp; BR() &amp; "Please review payment terms."</expression>
    </formulas>
    <formulas>
        <name>NewAccountSubject</name>
        <dataType>String</dataType>
        <expression>"New Account Email - " &amp; {!Get_Account.Name}</expression>
    </formulas>
    <formulas>
        <name>NewAccountBody</name>
        <dataType>String</dataType>
        <expression>"A new ECOM_B2B account has been created."
&amp; BR() &amp; "Customer Name: " &amp; {!Get_Account.Name}
&amp; BR() &amp; "Customer ID: " &amp; IF(ISBLANK({!Get_Account.AccountNumber}), {!Get_Account.Id}, {!Get_Account.AccountNumber})
&amp; BR() &amp; "Please begin AP onboarding."</expression>
    </formulas>
    <formulas>
        <name>BranchSummarySubject</name>
        <dataType>String</dataType>
        <expression>"New Customer Onboarding Summary - " &amp; {!Get_Account.Name}</expression>
    </formulas>
    <formulas>
        <name>BranchSummaryBody</name>
        <dataType>String</dataType>
        <expression>"Customer receives New Account Email. Summary details:"
&amp; BR() &amp; "Customer ID: " &amp; IF(ISBLANK({!Get_Account.AccountNumber}), {!Get_Account.Id}, {!Get_Account.AccountNumber})
&amp; BR() &amp; "Customer Name: " &amp; {!Get_Account.Name}
&amp; BR() &amp; "Delivery preferences: " &amp; IF(ISBLANK({!Get_Account.ShippingStreet}), "Not Provided", "Shipping address on file")
&amp; BR() &amp; "Estimated weekly spend: Not Provided"
&amp; BR() &amp; "If manual delivery address entry: " &amp; IF(ISBLANK({!Get_Account.ShippingStreet}), "Yes", "No")
&amp; BR() &amp; IF(ISBLANK({!Get_Account.ShippingStreet}), "", "Delivery address: " &amp; {!Get_Account.ShippingStreet} &amp; ", " &amp; {!Get_Account.ShippingCity} &amp; ", " &amp; {!Get_Account.ShippingState} &amp; " " &amp; {!Get_Account.ShippingPostalCode})</expression>
    </formulas>
    <interviewLabel>ECOM B2B Onboarding Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ECOM B2B Onboarding Contact</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>176</locationX>
        <locationY>80</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_ECOM_B2B</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Branch_Contact_Master</name>
        <label>Get Branch Contact Master</label>
        <locationX>176</locationX>
        <locationY>260</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Branch_Master_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Title</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Branch Contact Master</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Account_AP</name>
        <label>Get Account AP Contact</label>
        <locationX>176</locationX>
        <locationY>860</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Parent_Account_AP</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Department</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>AP</stringValue>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Parent_Account_AP</name>
        <label>Get Parent Account AP Contact</label>
        <locationX>176</locationX>
        <locationY>940</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_New_Account_Recipients</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Account.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Department</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>AP</stringValue>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Check_ECOM_B2B</name>
        <label>Check ECOM B2B</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <defaultConnectorLabel>Not ECOM_B2B</defaultConnectorLabel>
        <rules>
            <name>Is_ECOM_B2B</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsEcomB2B</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Branch_Contact_Master</targetReference>
            </connector>
            <label>ECOM_B2B</label>
        </rules>
    </decisions>
    <decisions>
        <name>Branch_Master_Exists</name>
        <label>Branch Master Exists?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Branch_Master</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Branch_Contact_Master.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Buyer_Account</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Buyer_Account</name>
        <label>Is Account Buyer?</label>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <defaultConnector>
            <targetReference>Is_PayLater_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Buyer_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsBuyerAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Buyer_Account_Email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_PayLater_Account</name>
        <label>Does Credit Status say PayLater?</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <defaultConnector>
            <targetReference>Get_Account_AP</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>PayLater_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsPayLaterAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_PayLater_Account_Email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_New_Account_Recipients</name>
        <label>Has New Account Recipients?</label>
        <locationX>176</locationX>
        <locationY>1020</locationY>
        <defaultConnector>
            <targetReference>Send_Branch_Summary_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No AP Recipients</defaultConnectorLabel>
        <rules>
            <name>Has_Recipients</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewAccountRecipients</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_New_Account_Email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <actionCalls>
        <name>Send_Buyer_Account_Email</name>
        <label>Send Buyer Account Email</label>
        <locationX>44</locationX>
        <locationY>550</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Is_PayLater_Account</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Branch_Contact_Master.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>BuyerAccountSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>BuyerAccountBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_PayLater_Account_Email</name>
        <label>Send PayLater Account Email</label>
        <locationX>308</locationX>
        <locationY>760</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Get_Account_AP</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Account.Owner.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>PayLaterSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>PayLaterBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_New_Account_Email</name>
        <label>Send New Account Email</label>
        <locationX>176</locationX>
        <locationY>1120</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Send_Branch_Summary_Email</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>NewAccountRecipients</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>NewAccountSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>NewAccountBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_Branch_Summary_Email</name>
        <label>Send New Customer Branch Contact Master Mail</label>
        <locationX>176</locationX>
        <locationY>1220</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Branch_Contact_Master.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>BranchSummarySubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>BranchSummaryBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
