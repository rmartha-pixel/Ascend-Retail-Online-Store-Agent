    <hasActivationRequired>false</hasActivationRequired>
    <label>Simple Apex Email API</label>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>Simple_Apex_Email</flow>
    </flowAccesses>
    <userPermissions>
        <enabled>true</enabled>
        <name>RunFlow</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>CanExitFlowViaAPI</name>
    </userPermissions>
</PermissionSet>
